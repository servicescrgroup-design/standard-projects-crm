# On Vercel these come from the Supabase integration automatically. Locally, copy them from
# Vercel → Project → Settings → Environment Variables (or `npx vercel env pull .env`).
# App (pooled, port 6543):
POSTGRES_PRISMA_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations (direct, port 5432):
POSTGRES_URL_NON_POOLING="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Signs sign-in cookies. Optional when SUPABASE_JWT_SECRET is present (the integration sets it).
SUPABASE_JWT_SECRET=""
SESSION_SECRET=""

# Shared secret for POST /api/sync/ingest (Gmail/Calendar sync worker). Leave empty to disable.
SYNC_INGEST_SECRET=""

# Only used by `npm run db:seed` to create the first owner.
OWNER_NAME=""
OWNER_EMAIL=""
APP_URL="http://localhost:3000"
