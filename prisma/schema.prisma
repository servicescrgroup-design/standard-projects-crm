// Postgres (Supabase). Variable names match Vercel's Supabase integration, which sets them automatically:
// POSTGRES_PRISMA_URL = pooled connection for the app; POSTGRES_URL_NON_POOLING = direct, for migrations.
// Enum-like fields are strings validated in src/lib/domain.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Team {
  id    String @id @default(cuid())
  name  String
  users User[]
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  role         String // OWNER | TEAM_LEAD | REP
  teamId       String?
  team         Team?             @relation(fields: [teamId], references: [id])
  leads        Lead[]
  activities   Activity[]
  goals        Goal[]
  invites      Invite[]
  reports      Report[]
  mailboxes    Mailbox[]
  twilio       TwilioConnection?
  emailDrafts  EmailDraft[]
  passwordHash String? // null until the person sets a password via their invite link
  preferences  Json              @default("{}") // per-user UI settings, e.g. dashboard widget order
  createdAt    DateTime          @default(now())
}

/**
 * One-time link for setting (or resetting) a password. Only a hash of the token is stored.
 */
model Invite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/**
 * Failed sign-ins, for throttling password guessing.
 */
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Lead {
  id                String       @id @default(cuid())
  company           String
  contactName       String?
  email             String?
  phone             String?
  website           String?
  location          String?
  industry          String?
  serviceInterest   String?
  source            String       @default("MANUAL") // see SOURCES in src/lib/domain.ts
  sourceLink        String?
  externalRef       String?      @unique // e.g. the Notion page URL it was imported from; makes imports re-runnable
  priority          String? // A | B | C
  segment           String? // e.g. Consignment, Spa, Website-Marketing, Rental, Gym, Export-Trading, Multi-location
  address           String?
  socialLinks       String?
  googleRating      Float?
  googleReviews     Int?
  whyFit            String?
  needs             String?
  offersToPitch     String[]     @default([])
  caseStudies       String[]     @default([])
  notes             String?
  budget            Int          @default(0) // customer's stated budget, minor units
  package           String? // Starter | Business | Growth | Custom
  lostReason        String?
  boardPosition     Float? // manual order within a Kanban column (lower = higher up); null = default ordering
  stage             String       @default("NEW") // see STAGES in src/lib/domain.ts
  value             Int          @default(0) // one-off value, pence
  monthlyValue      Int          @default(0) // recurring value, pence
  ownerId           String?
  owner             User?        @relation(fields: [ownerId], references: [id])
  nextFollowUpAt    DateTime?
  lastContactAt     DateTime?
  lastReplyAt       DateTime?
  unansweredTouches Int          @default(0)
  stageChangedAt    DateTime     @default(now())
  activities        Activity[]
  emailDrafts       EmailDraft[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([ownerId])
  @@index([stage])
  @@index([priority])
  @@index([segment])
  @@index([ownerId, stage])
  @@index([nextFollowUpAt])
}

model Activity {
  id         String   @id @default(cuid())
  type       String // CALL | EMAIL_OUT | EMAIL_IN | MEETING | VISIT | NOTE | PROPOSAL
  outcome    String? // e.g. CONNECTED | NO_ANSWER | VOICEMAIL | INTERESTED | NOT_INTERESTED
  summary    String?
  source     String   @default("MANUAL") // MANUAL | GMAIL | OUTLOOK | CALENDAR | BOT
  externalId String?  @unique // provider message id / Calendar event id, makes sync idempotent
  subject    String? // emails: subject line
  threadId   String? // emails: Gmail thread id / Outlook conversation id
  webLink    String? // emails: open the message in Gmail / Outlook
  mailboxId  String? // emails: the connected mailbox it was synced from or sent through
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([userId, occurredAt])
  @@index([threadId])
}

model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric String // CALLS | EMAILS | MEETINGS | DEALS_WON | REVENUE_WON
  period String // WEEK | MONTH
  target Int

  @@unique([userId, metric, period])
}

/**
 * Marketing spend per lead source per month, entered by the owner. Used for customer acquisition cost.
 */
model AcquisitionSpend {
  id          String   @id @default(cuid())
  source      String // see SOURCES in src/lib/domain.ts
  month       String // YYYY-MM
  amount      Int // minor units (satang)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, month])
}

/**
 * A saved report-builder configuration.
 */
model Report {
  id        String   @id @default(cuid())
  title     String
  config    Json
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shared    Boolean  @default(false) // visible to everyone in the workspace (results still respect each viewer's access)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/**
 * A user's connected Gmail or Outlook mailbox. Tokens are AES-256-GCM encrypted (src/lib/server/crypto.ts)
 * and never logged. cursor = Gmail historyId, or the ISO time of the last Outlook sync.
 */
model Mailbox {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String // GMAIL | OUTLOOK
  address         String
  refreshToken    String // encrypted
  accessToken     String? // encrypted, short-lived cache
  accessExpiresAt DateTime?
  cursor          String?
  labelId         String? // Gmail id of the "Standard Projects/Outreach Sent" label
  status          String    @default("ACTIVE") // ACTIVE | ERROR (needs reconnecting)
  lastError       String?
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, provider])
}

/**
 * An email written in the CRM. Reps can only submit for approval; owners and team leads send.
 */
model EmailDraft {
  id                String    @id @default(cuid())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId          String
  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  to                String
  subject           String
  body              String
  replyToActivityId String? // reply in that email's thread
  status            String    @default("DRAFT") // DRAFT | AWAITING_APPROVAL | SENT | FAILED
  approvedById      String?
  sentAt            DateTime?
  sentActivityId    String?
  error             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([leadId])
  @@index([status])
}

/**
 * One-time tickets the database scheduler (pg_cron) creates right before calling /api/email/sync,
 * so the sync endpoint can trust the call without a shared secret.
 */
model CronTicket {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

/**
 * An agent's own Twilio account for calling from the browser. The API key secret is AES-256-GCM
 * encrypted; the TwiML app is created by the CRM and points at /api/voice/twiml.
 */
model TwilioConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountSid   String
  apiKeySid    String
  apiKeySecret String // encrypted
  appSid       String // TwiML app created by the CRM
  callerId     String // E.164 Twilio number (or verified caller ID) calls come from
  record       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
